# CLASSY Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/classy?retryWrites=true&w=majority

# JWT Secret (change to a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=7d

# Admin Default Credentials
ADMIN_EMAIL=admin@classy.com
ADMIN_PASSWORD=admin123

# API Base URL (for image URLs)
API_URL=https://your-backend-domain.com

# WhatsApp Business Number
WHATSAPP_NUMBER=201226832747

# Server Port
PORT=5000
